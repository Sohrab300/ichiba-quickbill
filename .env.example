# Supabase Configuration for Ichiba POS

# Your Supabase Project URL (safe for client, found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Service Role Key (SERVER-ONLY: NEVER expose to browser, no NEXT_PUBLIC_ prefix)
# Used exclusively server-side in lib/supabase/server.ts to perform authenticated operations and bypass RLS
SUPABASE_SERVICE_ROLE_KEY=
