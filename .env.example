# Supabase Configuration for Ichiba POS

# Your Supabase Project URL (safe for client, found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_..., Project Settings -> API Keys).
# Used only by the cookie-based Auth client (sign-in, session refresh in src/proxy.ts).
# Safe to expose: tables have RLS with no policies, so it cannot read or write store data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Service Role / secret key (SERVER-ONLY: NEVER expose to browser, no NEXT_PUBLIC_ prefix)
# Used exclusively server-side in src/lib/supabase/server.ts for all data access (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=
